cabal-version:      3.0
name:               mplc
version:            0.1.0.0
synopsis:           Compiler/Interpreter for El MegaProbe Language
author:             Isaac Hiram Lopez Diaz
maintainer:         isaac.lopez@upr.edu
category:           Language
build-type:         Simple

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wredundant-constraints
        -Wunused-packages

executable mplc
    import:           warnings
    main-is:          Main.hs
    other-modules:
        InterpM
        TypeChecker
        Primitives
        Eval
    build-depends:    base ^>=4.18.3.0
                    , mpl-core
                    , mtl
                    , df
    hs-source-dirs:   src
    default-language: GHC2021
