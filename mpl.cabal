cabal-version:      3.0
name:               mpl
version:            0.1.0.0
synopsis:           Compiler/Interpreter for El MegaProbe Language
author:             Isaac Hiram Lopez Diaz
maintainer:         isaac.lopez@upr.edu
category:           Language
build-type:         Simple

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wredundant-constraints
        -Wunused-packages

executable mpl
    import:           warnings
    main-is:          Main.hs
    other-modules:
        InterpM
        TypeChecker
        Primitives
        Eval
        Parser
        Syntax
        Lexer
        MPLTypes
        Dataframe
        CodeGen
    build-depends:    base ^>=4.18.3.0
                    , mtl
                    , parsec
    hs-source-dirs:   src
    default-language: GHC2021
    include-dirs:     cbits/include
    if os(linux)
        pkgconfig-depends:
            arrow-cuda-glib
    pkgconfig-depends:
        arrow-glib
    c-sources:
        cbits/mpl_arrow_glib.c